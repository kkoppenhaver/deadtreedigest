{
  "manifest_version": 3,
  "name": "Dead Tree Digest — Save",
  "version": "0.1.0",
  "description": "Save the page you're reading to your Dead Tree Digest library. It arrives in print with your next issue.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Dead Tree Digest"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://dtd-api.keanan-75b.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dtd-api.keanan-75b.workers.dev/setup*"
      ],
      "js": [
        "setup.js"
      ]
    }
  ]
}
