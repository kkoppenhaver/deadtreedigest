# Lulu Print API credentials — create a free account at https://developers.lulu.com
# (sandbox keys come from https://developers.sandbox.lulu.com — separate signup)
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# "production" or "sandbox" — pricing is the same; keys are environment-specific
LULU_ENV=production

# Shipping destination for quotes (your address)
SHIP_CITY=
SHIP_STATE=
SHIP_POSTCODE=
SHIP_STREET1=
SHIP_PHONE=+1 555 555 5555

# DigitalHumani (tree planting) — register at https://my.digitalhumani.com/register,
# keys + enterpriseId on the Developer page. Trees are $1 each, invoiced monthly
# by the reforestation org directly. DH_PROJECT_ID is pinned after querying
# GET /project (we plant with TIST).
DH_ENTERPRISE_ID=
DH_API_KEY=
DH_SANDBOX_KEY=
DH_PROJECT_ID=
