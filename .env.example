# Lulu Print API credentials — create a free account at https://developers.lulu.com
# (sandbox keys come from https://developers.sandbox.lulu.com — separate signup)
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# "production" or "sandbox" — pricing is the same; keys are environment-specific
LULU_ENV=production

# Shipping destination for quotes (your address)
SHIP_CITY=
SHIP_STATE=
SHIP_POSTCODE=
SHIP_STREET1=
SHIP_PHONE=+1 555 555 5555
